# ============================================================
# GraphAtlas environment template
# Copy to .env and edit: cp .env.example .env
# ============================================================

# ---------- Services ----------
API_PORT=3001
WEB_PORT=3000

# Path to the `uv` binary used to run the Python extractor sidecar (extractor/)
# UV_PATH=/Users/<you>/Library/Python/3.11/bin/uv

# Simple bearer token for write/admin API routes (generate a random string)
API_TOKEN=change-me

# ---------- Database (PostgreSQL 17 + pgvector) ----------
# Local Homebrew: postgres://localhost:5432/graphatlas
# Docker (pgvector/pgvector:pg17): postgres://graphatlas:graphatlas@localhost:5432/graphatlas
DATABASE_URL=postgres://graphatlas:graphatlas@localhost:5432/graphatlas

# ---------- Embedding (OpenAI-compatible endpoint; default text-embedding-3-small) ----------
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=sk-your-openai-key

# Local alternative (Ollama + bge-m3, zero API cost, dim 1024):
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_API_KEY=

# ---------- LLM (OpenAI-compatible chat endpoint for agent + extraction) ----------
AGENT_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL=deepseek-chat
AGENT_API_KEY=sk-your-llm-key

# ---------- Graph extraction (lightrag-hku; used by extractor/ from Day 2) ----------
LIGHTRAG_WORKING_DIR=.graph-rag-workdir
CHUNK_TOKEN_SIZE=512
CHUNK_OVERLAP_TOKEN_SIZE=64
